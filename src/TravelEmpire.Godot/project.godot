; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the committed baseline targets Godot 4.7.

config_version=5

[application]

config/name="TravelEmpire"
config/description="Build a transport empire across real countries and tutorial maps."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="TravelEmpire.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.12, 0.16, 1)
